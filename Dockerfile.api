FROM python:3.10-slim

# Instal dependensi sistem yang dibutuhkan
RUN apt-get update && apt-get install -y \
    build-essential \
    tesseract-ocr \
    tesseract-ocr-ind \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Salin requirements dan instal
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Salin kode backend
COPY . .

# Buat direktori yang dibutuhkan agar persistent
RUN mkdir -p /app/data /app/faiss_index

# Ekspose port API
EXPOSE 8000

# Jalankan API server
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
