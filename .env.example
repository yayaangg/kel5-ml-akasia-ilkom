# ============================================
# AKASIA v1.0 - Environment Variables
# ============================================
# Untuk testing, gunakan API key demo:
# Minta API key ke developer atau buat di https://console.groq.com
# ============================================

# Groq API Key (WAJIB diisi)
# Dapatkan gratis di: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# PETUNJUK UNTUK DOSEN:
# 1. Buka https://console.groq.com
# 2. Login/Daftar (gratis)
# 3. Buat API Key baru
# 4. Copy dan paste di atas (ganti your_groq_api_key_here)
# ============================================
ADMIN_USERNAME=username_admin
ADMIN_PASSWORD=password_admin

JWT_SECRET=kode_rahasia_untuk_jwt_token

# Untuk kode jwt bisa dibuat bebas, tapi pastikan cukup panjang dan kompleks untuk keamanan. Contoh: AKASIA_2026_f7K92LmQxP4N8sV1ZaR6WdT3HyB5UcE